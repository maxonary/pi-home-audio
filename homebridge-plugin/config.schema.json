{
  "pluginAlias": "PiHomeAudio",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "default": "Pi Home Audio"
      },
      "x7Host": {
        "type": "string",
        "title": "X7 API URL",
        "default": "http://192.168.2.132:8100"
      },
      "x7Token": {
        "type": "string",
        "title": "X7 API bearer token"
      },
      "officeEQ": {
        "type": "boolean",
        "title": "Enable Office EQ preset switches",
        "default": false
      }
    }
  }
}
